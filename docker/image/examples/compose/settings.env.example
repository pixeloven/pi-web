# Copy to settings.env and fill in what you use. Every line is optional. Both
# services read this file, so put no secrets here: they go in pi-web.env.

# --- PI WEB settings (web server) ----------------------------------------------
# PI_WEB_DEFAULT_THEME={"themeId":"themes:pi-web-light","auto":false}
# PI_WEB_HOST_ACCESS={"mode":"restricted","hosts":["pi.example.com"]}
# PI_WEB_INSTALLATION_NAME=pi-web

# --- One OpenAI-compatible model gateway (session daemon) ----------------------
# PI_WEB_LLM_BASE_URL=https://llm.example.com/v1
# PI_WEB_LLM_MODELS=model-one,model-two
# PI_WEB_LLM_PROVIDER=gateway
# PI_WEB_LLM_API=openai-completions

# --- One streamable-HTTP MCP server (session daemon) ---------------------------
# PI_WEB_MCP_URL=https://mcp.example.com/mcp
# PI_WEB_MCP_NAME=gateway
