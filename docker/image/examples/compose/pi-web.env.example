# Copy to pi-web.env and fill in what you use. Every line is optional; with
# none set, Pi uses its built-in providers and you can sign in from a terminal
# (see "Provider sign-in" in ../../README.md). Only the sessiond service reads
# this file. Keep it out of version control: it holds secrets. Non-secret
# settings go in settings.env.

# --- Model gateway and MCP server keys -----------------------------------------
# PI_WEB_LLM_API_KEY=
# PI_WEB_MCP_API_KEY=

# --- Pi built-in provider keys --------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Git and GitHub ---------------------------------------------------------------
# GH_TOKEN=
