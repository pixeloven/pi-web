# Copy to pi-web.env and fill in what you use. Every line is optional; with
# none set, Pi uses its built-in providers and you can sign in from a terminal
# (see "Provider sign-in" in ../../README.md). Keep pi-web.env out of version
# control: it holds secrets.

# --- One OpenAI-compatible model gateway --------------------------------------
# PI_WEB_LLM_BASE_URL=https://llm.example.com/v1
# PI_WEB_LLM_API_KEY=
# PI_WEB_LLM_MODELS=model-one,model-two
# PI_WEB_LLM_PROVIDER=gateway
# PI_WEB_LLM_API=openai-completions

# --- One streamable-HTTP MCP server --------------------------------------------
# PI_WEB_MCP_URL=https://mcp.example.com/mcp
# PI_WEB_MCP_API_KEY=
# PI_WEB_MCP_NAME=gateway

# --- Pi built-in provider keys --------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Git and GitHub ---------------------------------------------------------------
# GH_TOKEN=
