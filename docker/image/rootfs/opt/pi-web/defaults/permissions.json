{
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/.ssh/*": "deny",
      "**/.aws/credentials": "deny",
      "**/.aws/config": "deny",
      "**/.kube/config": "deny",
      "**/.gnupg/*": "deny",
      "**/id_rsa": "deny",
      "**/id_rsa.*": "deny",
      "**/id_ed25519": "deny",
      "**/id_ed25519.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/.pi/agent/auth.json": "deny",
      "**/.pi/agent/auth.json.*": "deny",
      "/home/node/.pi/agent/auth.json": "deny",
      "/home/node/.pi/agent/auth.json.*": "deny"
    },
    "bash": {
      "*": "allow",
      "*rm -rf /": "deny",
      "*rm -rf /*": "deny",
      "*rm -rf ~": "deny",
      "*rm -rf ~/*": "deny",
      "*sudo *": "deny",
      "*gh repo delete *": "deny",
      "*git *push *--force*": "deny",
      "*git *push -f*": "deny",
      "*git *push * -f*": "deny",
      "*git *push -uf*": "deny",
      "*git *push * -uf*": "deny",
      "*git *push -qf*": "deny",
      "*git *push * -qf*": "deny",
      "*git *push -vf*": "deny",
      "*git *push * -vf*": "deny",
      "*git *push -df*": "deny",
      "*git *push * -df*": "deny",
      "*git *push -nf*": "deny",
      "*git *push * -nf*": "deny",
      "*git *push -quf*": "deny",
      "*git *push * -quf*": "deny",
      "*git *push -uqf*": "deny",
      "*git *push * -uqf*": "deny",
      "*git *push *'-f*": "deny",
      "*git *push *'-uf*": "deny",
      "*git *push *'-qf*": "deny",
      "*git *push *'-vf*": "deny",
      "*git *push *'-df*": "deny",
      "*git *push *'-nf*": "deny",
      "*git *push *'-quf*": "deny",
      "*git *push *'-uqf*": "deny",
      "*git *push *\"-f*": "deny",
      "*git *push *\"-uf*": "deny",
      "*git *push *\"-qf*": "deny",
      "*git *push *\"-vf*": "deny",
      "*git *push *\"-df*": "deny",
      "*git *push *\"-nf*": "deny",
      "*git *push *\"-quf*": "deny",
      "*git *push *\"-uqf*": "deny",
      "*git *push *\\-f*": "deny",
      "*git *push *\\-uf*": "deny",
      "*git *push *\\-qf*": "deny",
      "*git *push *\\-vf*": "deny",
      "*git *push *\\-df*": "deny",
      "*git *push *\\-nf*": "deny",
      "*git *push *\\-quf*": "deny",
      "*git *push *\\-uqf*": "deny",
      "*git *push +*": "deny",
      "*git *push * +*": "deny",
      "*git *push '+*": "deny",
      "*git *push * '+*": "deny",
      "*git *push \"+*": "deny",
      "*git *push * \"+*": "deny",
      "*git *push \\+*": "deny",
      "*git *push * \\+*": "deny",
      "*--no-sandbox*": "deny",
      "*auth.json*": "deny"
    },
    "path_write": {
      "**/.pi/agent/extensions/pi-permission-system/*": "deny"
    }
  }
}
